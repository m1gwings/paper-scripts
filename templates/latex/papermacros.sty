\newif\ifcommentsvisible
\newif\ifcommentsapplied
\newif\ifcommentsreverted
\newcommand{\CommentsVisible}{\commentsvisibletrue\commentsappliedfalse\commentsrevertedfalse}
\newcommand{\CommentsApplied}{\commentsvisiblefalse\commentsappliedtrue\commentsrevertedfalse}
\newcommand{\CommentsReverted}{\commentsvisiblefalse\commentsappliedfalse\commentsrevertedtrue}
\ifdefstring{\ps@review}{visible}{\CommentsVisible}{%
  \ifdefstring{\ps@review}{applied}{\CommentsApplied}{%
    \ifdefstring{\ps@review}{reverted}{\CommentsReverted}{%
      \PackageError{papermacros}{Unknown review mode}{Use visible, applied, or reverted.}}}}
\newcommand{\ps@label}[1]{%
  \ifps@labels
    \ifmmode{}^{\scriptscriptstyle\textsf{[#1]}}\else\textsuperscript{\textsf{[#1]}}\fi
  \fi}
\newcommand{\ps@mathstrike}[2]{\mathpalette{\ps@mathstrikeaux{#1}}{#2}}
\newcommand{\ps@mathstrikeaux}[3]{%
  \begingroup
    \setbox\z@=\hbox{$\m@th#2#3$}%
    \rlap{\raisebox{.45\ht\z@}{\textcolor{#1}{\rule{\wd\z@}{.4pt}}}}%
    \box\z@
  \endgroup}
\newcommand{\ps@ins}[3]{%
  \ifcommentsvisible{\color{#1}\ps@label{#2+}#3}%
  \else\ifcommentsapplied#3\fi\fi}
\newcommand{\ps@del}[3]{%
  \ifcommentsvisible
    \begingroup
      \textcolor{#1}{\ps@label{#2-}}%
      \ifmmode\ps@mathstrike{#1}{#3}\mkern2mu
      \else\setstcolor{#1}\ps@strikeout{#3}\fi
    \endgroup
  \else\ifcommentsreverted#3\fi\fi}
\newcommand{\ps@delblock}[4]{%
  \ifcommentsvisible
    \ifps@presentation
      \begin{tcolorbox}[colback=white,colframe=#1,title={#2 (#3): deletion}]
    \else
      \begin{tcolorbox}[breakable,colback=white,colframe=#1,title={#2 (#3): deletion}]
    \fi
    #4\end{tcolorbox}%
  \else\ifcommentsreverted#4\fi\fi}
\newcommand{\ps@replacemath}[4]{%
  \ifcommentsvisible
    \begin{gathered}\ps@del{#1}{#2}{#3}\\\ps@ins{#1}{#2}{#4}\end{gathered}%
  \else\ps@del{#1}{#2}{#3}\ps@ins{#1}{#2}{#4}\fi}
\newcommand{\ps@note}[4]{%
  \ifcommentsvisible
    \begin{tcolorbox}[colback=white,colframe=#1,title={#2 (#3)}]#4\end{tcolorbox}%
  \fi}
\newcommand{\ps@out}[4]{%
  \ifcommentsvisible
    \ifps@presentation\ps@note{#1}{#2}{#3}{#4}%
    \else\marginpar{\raggedright\scriptsize\textcolor{#1}{\textbf{#2 (#3):} #4}}\fi
  \fi}
% Darkened Okabe--Ito-derived accents on white. Labels provide a second cue in
% grayscale and for color-vision deficiencies; labels=false explicitly opts out.
% No venue geometry or margin-note dimensions are changed.
\newcommand{\DeclarePaperAuthor}[4]{%
  \definecolor{#1Color}{HTML}{#4}%
  \expandafter\DeclareRobustCommand\csname #1\endcsname[1]{\ps@note{#1Color}{#2}{#3}{##1}}%
  \expandafter\DeclareRobustCommand\csname #1Out\endcsname[1]{\ps@out{#1Color}{#2}{#3}{##1}}%
  \expandafter\DeclareRobustCommand\csname #1Ins\endcsname[1]{\ps@ins{#1Color}{#3}{##1}}%
  \expandafter\DeclareRobustCommand\csname #1Del\endcsname[1]{\ps@del{#1Color}{#3}{##1}}%
  \expandafter\DeclareRobustCommand\csname #1DelBlock\endcsname[1]{\ps@delblock{#1Color}{#2}{#3}{##1}}%
  \expandafter\DeclareRobustCommand\csname #1ReplaceMath\endcsname[2]{\ps@replacemath{#1Color}{#3}{##1}{##2}}%
  % Moving arguments keep robust commands in .toc/.lof. PDF bookmarks use
  % proposed clean text (original text in reverted mode), without review colors.
  \AtBeginDocument{%
    \@ifundefined{pdfstringdefDisableCommands}{}{%
      \pdfstringdefDisableCommands{%
        \expandafter\def\csname #1Ins\endcsname##1{\ifcommentsreverted\else##1\fi}%
        \expandafter\def\csname #1Del\endcsname##1{\ifcommentsreverted##1\fi}%
        \expandafter\def\csname #1DelBlock\endcsname##1{\ifcommentsreverted##1\fi}%
        \expandafter\def\csname #1ReplaceMath\endcsname##1##2{\ifcommentsreverted##1\else##2\fi}%
        \expandafter\def\csname #1\endcsname##1{}%
        \expandafter\def\csname #1Out\endcsname##1{}%
      }%
    }%
  }%
}
