#!/usr/bin/env bash
set -euo pipefail

PROGRAM="paper-init"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() {
    echo "$PROGRAM: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 \
        || die "Required command '$1' is not installed."
}

write_standard_gitignore() {
    cat > .gitignore <<'GITIGNORE'
# VS Code local configuration
.vscode/

# LaTeX auxiliary files
*.aux
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.run.xml
*.bcf
*.nav
*.snm
*.vrb

# Generated root-document outputs
main.pdf
main.bbl

# Temporary editor files
*~
*.swp
*.swo

# OS metadata
.DS_Store
GITIGNORE
}

usage() {
    cat <<'HELP'
paper-init — create a local Overleaf + GitHub paper or poster repository

USAGE

    paper-init [--poster] OVERLEAF_PROJECT_ID GITHUB_REPOSITORY [LOCAL_DIRECTORY]

OPTIONS

    --poster    Default to ./poster and install beamerposter/TikZ instructions.
                An explicit LOCAL_DIRECTORY still takes precedence.
    -h, --help  Show this help.


EXAMPLES

    paper-init abc123def456 my-paper

        Creates ./paper connected to:

            overleaf -> supplied Overleaf project
            github   -> new private GitHub repository my-paper


    paper-init abc123def456 my-paper manuscript

        Uses ./manuscript instead of ./paper.


    paper-init --poster abc123def456 my-poster

        Creates ./poster with poster-specific AGENTS.md instructions.
        Uses the same paper commands for sync, preview, notify, and publish.


    paper-init abc123def456 my-organization/my-paper paper

        Creates the private GitHub repository under the specified
        organization/account.


WHAT THE COMMAND DOES

    1. checks Git and GitHub CLI;
    2. checks GitHub authentication;
    3. clones the Overleaf project;
    4. calls the Overleaf remote 'overleaf';
    5. detects the Overleaf default branch automatically;
    6. creates a standard .gitignore if none exists;
    7. runs 'paper init' to install the canonical paper instructions,
       task queue, and versioned workflow infrastructure;
    8. commits that generated bootstrap when needed;
    9. creates a PRIVATE GitHub repository;
   10. calls the GitHub remote 'github';
   11. pushes the complete initial history to GitHub;
   12. configures the base branch to track github/<base>;
   13. configures plain 'git push' to prefer GitHub.

The collaborative branch may be:

    main
    master
    or another branch name

No branch name is hard-coded.


MODEL

    overleaf/<base>
        Collaborative/published paper.

    github/<base>
        Private mirror/backup.

    github/<feature>
        Experimental branches.


AFTER SETUP

    paper doctor
    paper help
    paper examples


OVERLEAF AUTHENTICATION

Overleaf Git authentication is separate from university SSO.

When Git asks for the Overleaf password, paste your Overleaf Git
authentication token.

The username is:

    git
HELP
}

INIT_OPTIONS=()
POSITIONAL=()
DEFAULT_DIR=paper
while [[ $# -gt 0 ]]; do
    case "$1" in
        --poster) INIT_OPTIONS=(--poster); DEFAULT_DIR=poster ;;
        -h|--help) usage; exit 0 ;;
        --) shift; POSITIONAL+=("$@"); break ;;
        -*) die "Unknown option: $1. Run paper-init --help." ;;
        *) POSITIONAL+=("$1") ;;
    esac
    shift
done
set -- "${POSITIONAL[@]}"

if [[ $# -lt 2 || $# -gt 3 ]]; then
    usage
    exit 1
fi

OVERLEAF_ID="$1"
GITHUB_REPO="$2"
LOCAL_DIR="${3:-$DEFAULT_DIR}"

need git
need gh

echo "Checking GitHub authentication..."

if ! gh auth status >/dev/null 2>&1; then
    die "GitHub CLI is not authenticated.

Run:
    gh auth login

Then rerun paper-init."
fi

if [[ -e "$LOCAL_DIR" ]]; then
    [[ -d "$LOCAL_DIR/.git" || -f "$LOCAL_DIR/.git" ]] \
        || die "Existing directory is not a Git repository."
    cd "$LOCAL_DIR"
    EXISTING_OVERLEAF="$(git remote get-url overleaf 2>/dev/null || true)"
    [[ "$EXISTING_OVERLEAF" == "https://git@git.overleaf.com/$OVERLEAF_ID" || "$EXISTING_OVERLEAF" == "https://git.overleaf.com/$OVERLEAF_ID" ]] \
        || die "Existing Overleaf remote does not match; refusing to repoint it."
    EXISTING_GITHUB="$(git remote get-url github 2>/dev/null || true)"
    EXPECTED_GITHUB="$(gh repo view "$GITHUB_REPO" --json nameWithOwner --jq .nameWithOwner)"
    [[ "$EXISTING_GITHUB" == "https://github.com/$EXPECTED_GITHUB" || "$EXISTING_GITHUB" == "https://github.com/$EXPECTED_GITHUB.git" || "$EXISTING_GITHUB" == "git@github.com:$EXPECTED_GITHUB.git" ]] \
        || die "Existing GitHub remote does not match; refusing to repoint it."
    exec bash "$SCRIPT_DIR/paper" init "${INIT_OPTIONS[@]}"
fi

OVERLEAF_URL="https://git@git.overleaf.com/${OVERLEAF_ID}"

echo
echo "Cloning Overleaf project into '$LOCAL_DIR'..."
echo

git clone "$OVERLEAF_URL" "$LOCAL_DIR"

cd "$LOCAL_DIR"

echo
echo "Renaming Overleaf remote:"
echo "    origin -> overleaf"

git remote rename origin overleaf

BASE_BRANCH="$(
    git symbolic-ref --quiet --short HEAD 2>/dev/null || true
)"

if [[ -z "$BASE_BRANCH" ]]; then
    die "Could not determine the checked-out Overleaf default branch."
fi

echo
echo "Detected collaborative branch:"
echo "    $BASE_BRANCH"

if [[ ! -e .gitignore ]]; then
    echo
    echo "No .gitignore found."
    echo "Creating the standard paper .gitignore..."

    write_standard_gitignore

    git add .gitignore
    git commit -m "Add standard paper gitignore"
else
    echo
    echo "Existing .gitignore found."
    echo "Leaving it unchanged."
fi

echo
echo "Installing canonical paper workflow and task instructions..."

bash "$SCRIPT_DIR/paper" init "${INIT_OPTIONS[@]}"

git add -- AGENTS.md .codex .github .paper notes tasks
if ! git diff --cached --quiet; then
    git commit -m "Initialize paper workflow"
fi

echo
echo "Creating PRIVATE GitHub repository:"
echo "    $GITHUB_REPO"
echo

gh repo create "$GITHUB_REPO" \
    --private \
    --source=. \
    --remote=github \
    --push

echo
echo "Configuring '$BASE_BRANCH' to track github/$BASE_BRANCH..."

git branch \
    --set-upstream-to="github/$BASE_BRANCH" \
    "$BASE_BRANCH"

echo
echo "Configuring GitHub as the default push destination..."

git config remote.pushDefault github

echo
echo "========================================"
echo "Paper repository successfully configured"
echo "========================================"

echo
echo "Directory:"
echo "    $(pwd)"

echo
echo "Collaborative branch:"
echo "    $BASE_BRANCH"

echo
echo "Remotes:"
git remote -v

echo
echo "Safety model:"
echo "    Overleaf = collaborative publication target"
echo "    GitHub   = private mirror / feature branches"

echo "Recommended next commands:"
echo
echo "    paper doctor"
echo "    paper help"
echo "    paper examples"
echo "    paper open"
