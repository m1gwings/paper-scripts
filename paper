#!/usr/bin/env bash
set -euo pipefail

PROGRAM="paper"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

helper() {
    need python3
    python3 "$SCRIPT_DIR/lib/$1.py" "${@:2}"
}

die() { echo "$PROGRAM: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Required command '$1' is not installed."; }
root() { git rev-parse --show-toplevel 2>/dev/null || die "Not inside a Git repository."; }
branch() { git symbolic-ref --quiet --short HEAD 2>/dev/null || die "Detached HEAD; inspect 'git status'."; }
remote_ok() { git remote get-url "$1" >/dev/null 2>&1 || die "Missing remote '$1'."; }

clean() {
    if [[ -n "$(git status --porcelain)" ]]; then
        git status --short
        die "Working tree is not clean. Commit or discard changes first."
    fi
}

no_git_operation() {
    local d
    d="$(git rev-parse --git-dir)"

    if [[ -d "$d/rebase-merge" || -d "$d/rebase-apply" \
        || -f "$d/MERGE_HEAD" || -f "$d/CHERRY_PICK_HEAD" \
        || -f "$d/REVERT_HEAD" ]]; then

        die "A Git operation is already in progress.
Run 'git status'.

To abandon a rebase:
    git rebase --abort"
    fi
}

base_branch() {
    if [[ -n "${PAPER_BASE_BRANCH:-}" ]]; then
        git check-ref-format --branch "$PAPER_BASE_BRANCH" >/dev/null \
            || die "Invalid configured base branch."
        printf '%s\n' "$PAPER_BASE_BRANCH"
        return
    fi
    local ref

    ref="$(git symbolic-ref --quiet --short refs/remotes/overleaf/HEAD 2>/dev/null || true)"

    if [[ -n "$ref" ]]; then
        echo "${ref#overleaf/}"
        return
    fi

    git show-ref --verify --quiet refs/remotes/overleaf/main && {
        echo main
        return
    }

    git show-ref --verify --quiet refs/remotes/overleaf/master && {
        echo master
        return
    }

    die "Cannot determine Overleaf's default branch.

Try:
    git fetch overleaf
    git remote set-head overleaf -a"
}

require_base() {
    git show-ref --verify --quiet "refs/heads/$BASE" \
        || die "Overleaf base branch is '$BASE', but no local '$BASE' exists."
}

# Fetch both authorities before changing any local branch. Keep exact leases:
# an implicit lease can be silently refreshed by an editor's background fetch.
sync_collaborative_base() {
    if [[ "$EXECUTION" == cloud ]]; then
        helper cloud sync
        no_git_operation
        clean
        git fetch --prune github
        if ! git show-ref --verify --quiet "refs/heads/$BASE"; then
            git branch "$BASE" "refs/remotes/github/$BASE"
        fi
        git switch "$BASE"
        git rebase "refs/remotes/github/$BASE"
        return
    fi
    git fetch --prune github
    git fetch overleaf
    if [[ -n "${PAPER_EXPECTED_SHA:-}" ]]; then
        [[ "$(git rev-parse --verify "refs/remotes/github/$PAPER_EXPECTED_BRANCH")" == "$PAPER_EXPECTED_SHA" ]] \
            || die "Requested branch changed since review; publication refused."
    fi
    GITHUB_BASE_OID="$(git rev-parse --verify "refs/remotes/github/$BASE" 2>/dev/null || true)"
    git show-ref --verify --quiet "refs/remotes/overleaf/$BASE" \
        || die "Overleaf base '$BASE' is missing."
    git switch "$BASE"
    if [[ -n "$GITHUB_BASE_OID" ]]; then
        git rebase "$GITHUB_BASE_OID"
    fi
    # Overleaf requires a linear history; preserve the original rebase model.
    git rebase "refs/remotes/overleaf/$BASE"
}

verify_ci_tree() {
    if [[ -n "${PAPER_TRUSTED_SHA:-}" ]]; then
        git diff --quiet "$PAPER_TRUSTED_SHA" "$1" -- .paper .github \
            || die "CI refuses infrastructure changes from paper content. Upgrade trusted infrastructure locally."
    fi
}

push_base_backup() {
    verify_ci_tree "$BASE"
    git push --force-with-lease="refs/heads/$BASE:$GITHUB_BASE_OID" \
        -u github "$BASE:refs/heads/$BASE"
}

show_divergence() {
    local r="$1" ahead behind

    if git show-ref --verify --quiet "refs/remotes/$r/$BASE"; then
        read -r ahead behind < <(
            git rev-list --left-right --count "$BASE...$r/$BASE"
        )

        printf "%-20s local ahead: %-3s remote ahead: %-3s\n" \
            "$r/$BASE" "$ahead" "$behind"
    else
        printf "%-20s not fetched / not found\n" "$r/$BASE"
    fi
}

write_gitignore() {
    cat > .gitignore <<'GITIGNORE'
# VS Code local configuration
.vscode/

# LaTeX auxiliary files
*.aux
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.run.xml
*.bcf
*.nav
*.snm
*.vrb

# Generated root-document outputs
main.pdf
main.bbl

# Temporary editor files
*~
*.swp
*.swo

# OS metadata
.DS_Store
GITIGNORE
}

create_init_file() {
    local path="$1"
    if [[ -e "$path" || -L "$path" ]]; then
        printf 'Kept existing %s\n' "$path"
    else
        (set -o noclobber; cat > "$path")
        printf 'Created %s\n' "$path"
    fi
}

init_paper() {
    local path

    # Check directory conflicts before creating anything; do not follow links.
    for path in notes tasks; do
        [[ ! -L "$path" && ( ! -e "$path" || -d "$path" ) ]] \
            || die "Cannot initialize: '$path' must be a directory, not a file or symlink."
    done
    for path in AGENTS.md notes/README.md tasks/index.md tasks/template.md; do
        [[ ! -d "$path" ]] \
            || die "Cannot initialize: '$path' is a directory."
    done

    mkdir -p notes tasks

    create_init_file AGENTS.md <<'AGENTS'
# Theoretical paper instructions

## Project and editing

- Follow `.paper/WORKFLOW.md` for repository lifecycle operations. Use `paper start`, `paper backup`, `paper sync`, and `paper publish`; publish only when explicitly authorized.
- Inspect the existing layout, notation, macros, and build instructions before editing.
- Keep research knowledge (derivations, conjectures, examples, reusable proof audits) in `notes/`. Keep task management, checkpoints, and revision-specific verification in `tasks/`; link between them instead of duplicating content.
- Preserve pre-existing user edits. Make the smallest change sufficient for correctness; avoid unrelated stylistic changes.
- Preserve the proof strategy unless asked to redesign it. Do not silently strengthen assumptions or claims.
- Check index ranges, stopping times, conditioning, constants, and parameter regimes explicitly. Distinguish conjectural, conditional, and proved claims.
- Prefer explicit algebraic derivations and compact inequality chains. For repeated calculations, cite the analogous argument and give the needed result.

## LaTeX and verification

- Preserve existing notation and macros whenever possible.
- Do not replace custom macros with expanded LaTeX.
- Preserve labels and references unless a structural change requires otherwise.
- Use semantic label prefixes and `snake_case` identifiers, such as `eq:stopped_regret` or `lem:time_stopped_kl`; do not use spaces or hyphens in labels.
- Introduce every multiline displayed equation with grammatically appropriate punctuation, normally a colon.
- End every multiline displayed equation with punctuation appropriate to the surrounding sentence.
- In a `cases` block, do not punctuate the individual branches; place punctuation only after the complete `cases` expression.
- For integration with respect to the Lebesgue measure, write `\mathrm{d}\lambda(x)` rather than `\mathrm{d}x`.
- Prefer compact multiline derivations rather than one equality per line.
- In set-builder notation, use `\text{ s.t. }` rather than a colon.
- Do not modify the AISTATS style files.
- Do not add LaTeX packages unless necessary.

- After changing LaTeX, compile using the project's build workflow and fix errors caused by the edits. Record the command, result, and any unresolved verification limitation.
- Summarize mathematical changes separately from typographical changes.

## Notifications

- You may proactively notify the user about a useful completed result, a material blocker, or a requested milestone. If the user says "At the end send me a notification with ...", treat that as authorization to do so.
- Use only `paper notify --title "TITLE" --message "MESSAGE" [--url "HTTPS_URL"]`. It always dispatches the trusted GitHub Actions notification workflow; do not call Pushover, a webhook, or the internal adapter directly.
- The same command works locally and in cloud environments. It requires authenticated GitHub access and the installed workflow, but notification credentials remain only in the protected GitHub environments. Never inspect, request, print, add, or commit those credentials.
- A local path is not a notification URL. For a requested PDF handoff, generate `output/pdf/NAME.pdf` when that is this repository's output convention, and do not commit it. The current supported PDF-link mechanism is the private GitHub Actions preview artifact: after the normal preview workflow has completed, it produces `paper.pdf` and its trusted notifier uses a URL of the form `https://github.com/OWNER/REPOSITORY/actions/runs/RUN_ID/artifacts/ARTIFACT_ID`. For a custom notification, pass an already available HTTPS artifact URL with `--url`; there is no `paper` command that uploads an arbitrary `output/pdf/` file or converts its local path into a link.

Example, once the preview artifact URL is available:

```bash
paper notify --title "Paper update" --message "Revised PDF is ready." \
  --url "https://github.com/OWNER/REPOSITORY/actions/runs/RUN_ID/artifacts/ARTIFACT_ID"
```

## Tasks and resumption

- Before substantial execution work, create or resume `tasks/NNN_short_name/task.md` using `tasks/template.md`, and link it in `tasks/index.md`. Reuse the task for related follow-ups. Substantial work includes multi-step edits, sustained proof work, or meaningful verification.
- Simple questions, tiny corrections, and discussion-only requests need no task record. Explicit instructions to make no changes also prohibit bookkeeping edits.
- Keep task folders stable. Put exactly one plain status line (e.g. `Status: active`) before the first subsection. Allowed statuses: queued, active, paused, blocked, done. Keep the index consistent with the task record. A queued idea does not authorize execution.
- When resuming, read the index and the relevant task's current checkpoint first, then inspect the working tree. Read older material only as needed; reconcile discrepancies rather than restarting completed work.
- Update the current checkpoint after substantive results and before stopping or handing off work. Record established results, unresolved obligations, decisions, affected files, verification, and the next concrete action. Save enough to resume in a fresh session without the chat.
- Keep records concise: replace stale checkpoint text, retain only useful decision history, and mark superseded arguments clearly. Link to proofs and logs instead of copying them. Add supporting files only when necessary.
- Mark a proof proved only when its obligations are satisfied; distinguish proof completion from manuscript integration and verification. Mark the task done only when its scope and required checks are complete.
- Task files preserve progress across interruptions; they do not automatically restart execution. Save milestones during work rather than relying only on an end-of-session handoff.

## Token use and delegation

- Default to one agent. Use targeted searches and reads; avoid repeatedly loading entire notes, histories, or logs. Run checks appropriate to the change and repeat them only when new evidence warrants it.
- Delegate bounded independent work to subagents only when the expected time or quality benefit justifies the additional token cost. Do not spawn agents for routine bookkeeping or small edits.
- The main agent owns the task checkpoint, integration, and compilation. Give parallel editors disjoint file ownership; prefer read-only assignments for independent audits. Record each assignment's scope, dependencies, results, and remaining obligations in the task.
AGENTS

    create_init_file notes/README.md <<'NOTES'
# Research notes

Keep mathematical derivations, examples, conjectures, and reusable proof arguments here, including unfinished mathematics. State assumptions and distinguish proved results from open claims.

Keep assignments, progress tracking, handoffs, and revision-specific verification in `../tasks/`. Link to the relevant task when useful; avoid duplicating mathematical content.
NOTES

    create_init_file tasks/index.md <<'INDEX'
# Task queue

List tasks in intended execution order. Each linked task record is authoritative for its scope and checkpoint; keep this status summary consistent. Preserve completed entries for reference.

| Task | Status | Record |
| --- | --- | --- |

For substantial work, copy `template.md` to `NNN_short_name/task.md` using the next unused number, and add a row above. Statuses: queued, active, paused, blocked, done. Keep folder names stable when status changes. Read only the relevant task and its linked material when resuming.

Use `paper task status` to list open tasks, `paper task status --all` to include completed tasks, and `paper task delete ID` to remove selected records with confirmation and a recovery copy in `.trash/`.
INDEX

    create_init_file tasks/template.md <<'TASK'
# NNN: Task title

Status: queued
Updated: YYYY-MM-DD

## Objective and scope

User request, constraints, authorization, and completion criteria.

## Steps

- [ ] Next meaningful step (add dependencies only if needed).

## Current checkpoint

- Established results and decisions:
- Unresolved obligations or blockers:
- Affected files and pre-existing edits to preserve:
- Verification: command/check, result, and what remains unverified.
- Next concrete action:

Link to supporting mathematics or audits instead of copying them. If delegating, record each assignment's scope, file ownership, dependencies, and result here. Keep only information needed to resume and verify the work.
TASK

    printf '\nPaper workflow initialized. Review the files before committing.\n'
    printf 'Existing files were preserved; merge any desired workflow rules into an existing AGENTS.md manually.\n'
}

task_command() {
    need python3
    # -c keeps stdin available for the deletion confirmation.
    python3 -c "$(cat <<'TASKS_PY'
import datetime
import os
from pathlib import Path
import re
import sys
import tempfile


def fail(message):
    raise SystemExit('paper task: ' + message)


def task_record(path):
    record = path / 'task.md'
    if record.is_symlink() or not record.is_file():
        return {'path': path, 'status': 'unknown', 'title': path.name,
                'progress': '-', 'next': 'Missing regular task.md'}
    text = record.read_text(encoding='utf-8')
    # Metadata belongs before the first subsection, not in historical quotes.
    header = re.split(r'^##\s', text, maxsplit=1, flags=re.M)[0]
    statuses = re.findall(r'^Status:[ \t]*([^\n]+)', header, re.M)
    status = statuses[0].strip().lower() if len(statuses) == 1 else 'unknown'
    if status not in {'queued', 'active', 'paused', 'blocked', 'done'}:
        status = 'unknown'
    title = re.search(r'^#\s+(.+)', header, re.M)
    steps = re.search(r'^## Steps\s*\n(.*?)(?=^## |\Z)', text, re.M | re.S)
    checks = re.findall(r'^\s*- \[([ xX])\]', steps[1], re.M) if steps else []
    next_action = re.search(r'^- Next concrete action:[ \t]*([^\n]*)', text, re.M)
    return {'path': path, 'status': status,
            'title': title[1].strip() if title else path.name,
            'progress': f'{sum(c.lower() == "x" for c in checks)}/{len(checks)}' if checks else '-',
            'next': next_action[1].strip() if next_action else ''}


def main():
    args = sys.argv[1:]
    action = args[0] if args else 'status'
    args = args[1:]
    if action not in {'status', 'delete'}:
        fail('Usage: paper task status [--all] | paper task delete ID [ID ...]')
    if action == 'status' and args not in ([], ['--all']):
        fail('Usage: paper task status [--all]')
    if action == 'delete' and not args:
        fail('Usage: paper task delete ID [ID ...]')
    tasks = Path('tasks')
    if tasks.is_symlink():
        fail('Refusing a symlinked tasks directory.')
    if not tasks.exists():
        if action == 'delete':
            fail('No tasks directory. Run paper init first.')
        print('No tasks directory. Run paper init to create a task queue.')
        return
    if not tasks.is_dir():
        fail('tasks is not a directory.')
    records = [task_record(p) for p in sorted(tasks.iterdir())
               if re.fullmatch(r'\d+_[a-z0-9_]+', p.name)
               and p.is_dir() and not p.is_symlink()]
    if action == 'status':
        visible = [r for r in records if args == ['--all'] or r['status'] != 'done']
        if not visible:
            print('No tasks.' if args else 'No open tasks. Use paper task status --all to include completed tasks.')
            return
        print('STATUS   STEPS  TASK')
        for r in visible:
            print(f'{r["status"]:<8} {r["progress"]:<6} {r["path"].name}: {r["title"]}')
            if r['next']:
                print('  Next: ' + r['next'])
        print('\nStatuses are read from task.md; step counts do not verify proofs or builds.')
        return

    selected = []
    for requested in args:
        matches = [r for r in records if r['path'].name == requested or
                   (requested.isdecimal() and int(r['path'].name.split('_', 1)[0]) == int(requested))]
        if len(matches) != 1:
            fail(f'Task {requested!r} is missing or ambiguous; use its full folder name.')
        if matches[0] not in selected:
            selected.append(matches[0])
    index = tasks / 'index.md'
    if index.is_symlink() or (index.exists() and not index.is_file()):
        fail('tasks/index.md must be a regular file.')
    trash = tasks / '.trash'
    if trash.is_symlink() or (trash.exists() and not trash.is_dir()):
        fail('tasks/.trash must be a directory, not a file or symlink.')
    original = index.read_bytes() if index.exists() else None
    names = [r['path'].name for r in selected]
    updated = original
    if original is not None:
        # Remove only table rows linking to the selected records.
        link = re.compile(r'\]\((?:\./)?(?:' + '|'.join(map(re.escape, names)) + r')/task\.md(?:#[^)]*)?\)')
        updated = ''.join(line for line in original.decode('utf-8').splitlines(keepends=True)
                          if not (line.lstrip().startswith('|') and link.search(line))).encode('utf-8')
    print('Remove these task records from the queue:')
    for r in selected:
        print(f'  {r["path"].name} [{r["status"]}]')
    print('Records will move to tasks/.trash; notes and manuscript files are preserved.')
    confirmation = ' '.join(names)
    try:
        answer = input(f'Type {confirmation!r} to confirm: ')
    except EOFError:
        answer = ''
    if answer != confirmation:
        print('Cancelled.')
        return
    # Do not overwrite queue changes made while the confirmation was pending.
    if index.is_symlink() or (index.read_bytes() if index.exists() else None) != original:
        fail('The queue changed during confirmation. Retry after reviewing it.')
    if trash.is_symlink() or tasks.is_symlink():
        fail('Task paths changed during confirmation. Retry after reviewing them.')
    for r in selected:
        if r['path'].is_symlink() or not r['path'].is_dir():
            fail('A selected task changed during confirmation. Retry after reviewing it.')
    trash.mkdir(exist_ok=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ-')
    batch = Path(tempfile.mkdtemp(prefix=stamp, dir=trash))
    if original is not None:
        (batch / 'index.md.before').write_bytes(original)
    moved = []
    pending = None
    try:
        if updated is not None:
            fd, name = tempfile.mkstemp(prefix='.index-', dir=tasks)
            pending = Path(name)
            with os.fdopen(fd, 'wb') as stream:
                stream.write(updated)
            pending.chmod(index.stat().st_mode & 0o777)
        for r in selected:
            source = r['path']
            source.rename(batch / source.name)
            moved.append(source)
        if pending is not None:
            pending.replace(index)
    except OSError:
        for source in reversed(moved):
            (batch / source.name).rename(source)
        raise
    finally:
        if pending is not None and pending.exists():
            pending.unlink()
    print(f'Deleted {len(selected)} task(s) from the queue. Recovery copy: {batch}')
    print('To restore, move the task folder back into tasks/ and re-add its index row.')
    print('Review links from other notes/tasks to the deleted records before committing.')


try:
    main()
except (OSError, UnicodeError) as error:
    fail(str(error))
TASKS_PY
)" "$@"
}

help_text() {
cat <<'HELP'
paper — Overleaf + GitHub workflow for LaTeX papers

MODEL
  overleaf/<base>   collaborative paper
                     (<base> is auto-detected: usually main/master)

  github/<base>     private mirror/backup

  github/<feature>  experimental branches


MENTAL MODEL

  commit
      Local checkpoint.

  backup
      Push current branch to GitHub only.

  publish
      Make committed work visible on Overleaf.


COMMANDS

  paper init
      Initialize theoretical-paper instructions, research notes,
      and a lightweight resumable task queue in this Git repository.
      Install/upgrade versioned preview and publication infrastructure.
      Preserve custom files; require no configured remotes. No commit/push.

  paper status
      Show base branch, current branch, status, branches,
      remotes, and cached divergence.

  paper notify --title TITLE --message MESSAGE [--url HTTPS_URL]
      Ask the trusted GitHub Actions workflow to send a notification.
      Provider credentials remain in protected GitHub environments.

  paper configure-ci [--environments-only]
      Configure default-branch-only CI environments and the Overleaf token.
      Requires GitHub repository administration access.

  paper configure-notifications [--device NAME] OWNER/REPO [OWNER/REPO ...]
      Prompt once for notification credentials and install/rotate them across
      every selected repository's protected GitHub environments.

  paper notify-test
      Send a test using the configured notification provider.

  paper task status [--all]
      List open tasks with recorded status, step counts, and next action.
      --all includes completed tasks. Reads local files; no AI calls.

  paper task delete ID [ID ...]
      Select tasks by number or full folder name and confirm deletion.
      Moves records into tasks/.trash and removes their queue rows.
      Research notes and manuscript files are preserved.
      Task commands require Python 3, but no configured remotes.

  paper sync
      While on the base branch, reconcile GitHub and Overleaf.
      Cloud mode asks CI to refresh the mirror first.

  paper commit "message"
      git add -A + local commit.
      Pushes nowhere.

  paper backup
      Push current branch to GitHub.
      Never touches Overleaf.

  paper start NAME
      Sync base branch, create NAME, and immediately
      back it up to GitHub.

  paper publish
      From base:
          sync -> GitHub backup -> Overleaf

      From feature:
          sync base
          -> rebase feature
          -> GitHub feature backup
          -> fast-forward base
          -> GitHub base backup
          -> Overleaf

      The feature branch is kept afterward. With PAPER_EXECUTION=cloud,
      request privileged CI publication and wait for its result.
      CI refuses a changed review SHA and infrastructure changes.

  paper abort
      Delete CURRENT non-base branch locally and from GitHub.
      Requires typing its exact name.
      Never touches Overleaf.

  paper clear-experiments
      Delete ALL non-base branches locally and from GitHub.
      Requires typing:

          DELETE EXPERIMENTS

      Never touches Overleaf.

  paper gitignore
      Create the standard paper .gitignore if none exists.
      Existing .gitignore files are never overwritten.

  paper build [ROOT.tex]
      Compile with latexmk.
      Defaults to main.tex.

  paper clean [ROOT.tex]
      Clean latexmk files.
      Defaults to main.tex.

  paper open
      Open the repository in VS Code.

  paper doctor
      Check configuration and useful tools.

  paper examples
      Show concrete example workflows.

  paper help
      Show this help.


CONFLICTS

If sync/publish stops with a conflict:

    git status

Resolve the files, then:

    git add <resolved-files>
    git rebase --continue

Repeat if necessary.

To abandon the rebase:

    git rebase --abort

Then:

    paper status

Do not blindly use:

    git reset --hard
    git clean -fd
HELP
}

