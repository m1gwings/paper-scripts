CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
    help|-h|--help)
        help_text
        exit 0
        ;;

    examples)
        examples_text
        exit 0
        ;;

    configure-ci)
        need git
        cd "$(root)"
        helper configure_ci "$@"
        exit 0
        ;;

    configure-notifications)
        need gh
        helper configure_ci notifications "$@"
        exit 0
        ;;

    notify|notify-test)
        if [[ "$CMD" == notify-test ]]; then
            [[ $# -eq 0 ]] || die "Usage: paper notify-test"
            set -- --title "Paper Scripts" --message "Notifications are working."
        fi
        need git
        need gh
        cd "$(root)"
        remote_ok github
        helper cloud notify "$@"
        exit 0
        ;;

    init)
        if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then
            echo "Usage: paper init"
            echo "Create research files and install/upgrade versioned .paper and Actions infrastructure."
            echo "Run inside a Git repository; no remotes required. Existing files are preserved."
            exit 0
        fi
        [[ $# -eq 0 ]] || die "Usage: paper init"
        need git
        REPO_ROOT="$(root)"
        cd "$REPO_ROOT"
        no_git_operation
        helper infrastructure preflight
        init_paper
        helper infrastructure install
        exit 0
        ;;

    task)
        if [[ "${1:-}" == --help || "${1:-}" == -h || "${1:-}" == help ]]; then
            echo "Usage: paper task status [--all] | paper task delete ID [ID ...]"
            echo "Status reads task.md metadata; delete confirms and moves records to tasks/.trash."
            echo "Requires Git and Python 3, but no configured remotes."
            exit 0
        fi
        need git
        REPO_ROOT="$(root)"
        cd "$REPO_ROOT"
        if [[ "${1:-}" == delete ]]; then
            no_git_operation
        fi
        task_command "$@"
        exit 0
        ;;
esac

need git

cd "$(root)"

remote_ok github
EXECUTION="${PAPER_EXECUTION:-$(git config --get paper.execution || echo auto)}"
if [[ "$EXECUTION" == auto ]]; then
    if git remote get-url overleaf >/dev/null 2>&1; then
        EXECUTION=local
    else
        EXECUTION=cloud
    fi
fi
[[ "$EXECUTION" == local || "$EXECUTION" == cloud ]] \
    || die "PAPER_EXECUTION must be auto, local, or cloud."
if [[ "$EXECUTION" == local ]]; then
    remote_ok overleaf
    BASE="$(base_branch)"
    require_base
else
    BASE="$(helper infrastructure get base_branch)"
    git check-ref-format --branch "$BASE" >/dev/null || die "Invalid configured base branch."
fi

case "$CMD" in

    status)
        echo "Repository: $(pwd)"
        echo "Base branch: $BASE"
        echo "Current branch: $(branch)"

        echo
        git status -sb

        echo
        echo "Local branches:"
        git branch -vv

        echo
        echo "Remotes:"
        git remote -v

        echo
        echo "Cached divergence (only as fresh as your last fetch/pull):"
        show_divergence overleaf
        show_divergence github
        ;;

    sync)
        no_git_operation
        clean

        [[ "$(branch)" == "$BASE" ]] \
            || die "Run 'paper sync' from '$BASE', not '$(branch)'."

        sync_collaborative_base

        echo "Synchronized '$BASE' with GitHub and Overleaf."
        if [[ "$EXECUTION" == cloud ]]; then
            echo "CI refreshed the GitHub mirror; Overleaf was not modified."
        else
            echo "GitHub was not modified."
        fi
        ;;

    commit)
        no_git_operation

        [[ $# -ge 1 ]] \
            || die 'Usage: paper commit "message"'

        git add -A

        if git diff --cached --quiet; then
            echo "Nothing to commit."
            exit 0
        fi

        git commit -m "$*"
        ;;

    backup)
        no_git_operation
        clean

        B="$(branch)"

        git push -u github "$B:refs/heads/$B"

        echo "Backed up '$B' to GitHub."
        echo "Overleaf was not modified."
        ;;

    start)
        no_git_operation
        clean
        branch >/dev/null

        [[ $# -eq 1 ]] \
            || die "Usage: paper start BRANCH_NAME"

        NEW="$1"

        git check-ref-format --branch "$NEW" >/dev/null 2>&1 \
            || die "Invalid branch name '$NEW'."

        [[ "$NEW" != "$BASE" ]] \
            || die "'$NEW' is the base branch."

        ! git show-ref --verify --quiet "refs/heads/$NEW" \
            || die "Local branch '$NEW' already exists."

        REMOTE_HEADS="$(git ls-remote --heads github "refs/heads/$NEW")" \
            || die "Could not check GitHub branches."
        [[ -z "$REMOTE_HEADS" ]] || die "GitHub branch '$NEW' already exists."

        sync_collaborative_base

        git switch -c "$NEW"
        git push -u github "$NEW"

        echo "Started '$NEW'."
        echo "Overleaf was not modified."
        ;;

    publish)
        [[ $# -eq 0 ]] || die "Usage: paper publish"
        no_git_operation
        clean

        B="$(branch)"
        if [[ "$EXECUTION" == cloud ]]; then
            SHA="$(git rev-parse HEAD)"
            git push -u github "$B:refs/heads/$B"
            helper cloud publish --branch "$B" --sha "$SHA"
            echo "CI publication succeeded. Updating this checkout."
            clean
            [[ "$(git rev-parse HEAD)" == "$SHA" && "$(branch)" == "$B" ]] \
                || die "Local work changed while CI ran; use paper sync from the base to update."
            git fetch --prune github
            if ! git show-ref --verify --quiet "refs/heads/$BASE"; then
                git branch "$BASE" "refs/remotes/github/$BASE"
            fi
            git switch "$BASE"
            git rebase "refs/remotes/github/$BASE"
            if [[ "$B" != "$BASE" ]]; then
                git update-ref "refs/heads/$B" "refs/remotes/github/$B" "$SHA"
            fi
            echo "Published successfully. Current branch: $BASE. Feature branches were kept."
            exit 0
        fi

        if [[ "$B" == "$BASE" ]]; then

            sync_collaborative_base
            push_base_backup
            git push overleaf "$BASE"

            echo "Published '$BASE' to GitHub and Overleaf."

        else
            WORK="$B"

            echo "1/6 Update '$BASE' from GitHub and Overleaf"
            sync_collaborative_base

            WORK_OID="$(git rev-parse --verify "refs/remotes/github/$WORK" 2>/dev/null || true)"
            echo "2/6 Rebase '$WORK' onto '$BASE'"
            git switch "$WORK"
            [[ -z "$WORK_OID" ]] || git rebase "$WORK_OID"
            git rebase "$BASE"

            verify_ci_tree "$WORK"
            echo "3/6 Back up '$WORK' to GitHub"
            git push --force-with-lease="refs/heads/$WORK:$WORK_OID" \
                -u github "$WORK:refs/heads/$WORK"

            echo "4/6 Fast-forward '$BASE'"
            git switch "$BASE"
            git merge --ff-only "$WORK"

            echo "5/6 Back up '$BASE' to GitHub"
            push_base_backup

            echo "6/6 Publish '$BASE' to Overleaf"
            git push overleaf "$BASE"

            echo
            echo "Published successfully."
            echo "Current branch: $BASE"
            echo "Feature '$WORK' was kept."
        fi
        ;;

    abort)
        no_git_operation
        clean

        B="$(branch)"

        [[ "$B" != "$BASE" ]] \
            || die "Cannot abort base branch '$BASE'."

        echo
        echo "This permanently deletes '$B':"
        echo "  - locally"
        echo "  - from GitHub, if present"
        echo
        echo "It does NOT modify '$BASE' or Overleaf."
        echo

        read -r -p "Type '$B' to confirm: " CONFIRM

        [[ "$CONFIRM" == "$B" ]] || {
            echo "Cancelled."
            exit 0
        }

        git switch "$BASE"

        if git ls-remote --exit-code --heads github "$B" >/dev/null 2>&1; then
            git push github --delete "$B"
        fi

        git branch -D "$B"

        echo "Discarded '$B'."
        echo "Overleaf was not modified."
        ;;

    clear-experiments)
        no_git_operation
        clean

        git switch "$BASE"

        mapfile -t LOCAL < <(
            git for-each-ref \
                --format='%(refname:short)' \
                refs/heads/ |
            grep -Fxv "$BASE" || true
        )

        REMOTE_HEADS="$(git ls-remote --heads github)" \
            || die "Could not read GitHub branches."

        mapfile -t REMOTE < <(
            printf '%s\n' "$REMOTE_HEADS" |
            awk '{sub("refs/heads/", "", $2); print $2}' |
            grep -Fxv "$BASE" |
            sed '/^$/d' || true
        )

        mapfile -t ALL < <(
            printf '%s\n' "${LOCAL[@]}" "${REMOTE[@]}" |
            sed '/^$/d' |
            sort -u
        )

        [[ ${#ALL[@]} -gt 0 ]] || {
            echo "No experimental branches found."
            exit 0
        }

        echo
        echo "The following non-base branches will be permanently deleted:"
        printf '  %s\n' "${ALL[@]}"
        echo
        echo "Overleaf and '$BASE' will NOT be modified."
        echo

        read -r -p "Type 'DELETE EXPERIMENTS' to confirm: " CONFIRM

        [[ "$CONFIRM" == "DELETE EXPERIMENTS" ]] || {
            echo "Cancelled."
            exit 0
        }

        for B in "${REMOTE[@]}"; do
            git push github --delete "$B"
        done

        for B in "${LOCAL[@]}"; do
            git branch -D "$B"
        done

        echo "All experimental branches removed."
        ;;

    gitignore)
        no_git_operation

        [[ ! -e .gitignore ]] \
            || die ".gitignore already exists; refusing to overwrite it."

        write_gitignore

        echo "Created .gitignore."
        echo
        echo "Review it, then:"
        echo
        echo '    paper commit "Add standard paper gitignore"'
        ;;

    build)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'. Usage: paper build [ROOT.tex]"

        latexmk \
            -pdf \
            -interaction=nonstopmode \
            -file-line-error \
            "$MAIN"
        ;;

    clean)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'. Usage: paper clean [ROOT.tex]"

        latexmk -C "$MAIN"
        ;;

    open)
        need code
        code .
        ;;

    doctor)
        echo "Repository: $(pwd)"
        echo "Detected base branch: $BASE"

        echo "Overleaf HEAD: $(
            git symbolic-ref \
                --quiet \
                --short \
                refs/remotes/overleaf/HEAD \
                2>/dev/null \
                || echo '<not set>'
        )"

        echo "Current branch: $(branch)"

        echo
        git status -sb

        echo
        echo "Remotes:"
        echo "  overleaf: $(git remote get-url overleaf)"
        echo "  github:   $(git remote get-url github)"

        echo
        UPSTREAM="$(
            git for-each-ref \
                --format='%(upstream:short)' \
                "refs/heads/$BASE"
        )"

        echo "Base upstream:"
        echo "  ${UPSTREAM:-<none>}"
        echo "  expected: github/$BASE"

        echo
        echo "Default push remote:"
        echo "  $(git config --get remote.pushDefault || echo '<none>')"
        echo "  expected: github"

        echo
        echo "Tools:"

        command -v gh >/dev/null 2>&1 \
            && echo "  gh       [OK]" \
            || echo "  gh       [MISSING]"

        command -v latexmk >/dev/null 2>&1 \
            && echo "  latexmk  [OK]" \
            || echo "  latexmk  [MISSING]"

        command -v code >/dev/null 2>&1 \
            && echo "  code     [OK]" \
            || echo "  code     [MISSING]"

        if command -v gh >/dev/null 2>&1; then
            gh auth status >/dev/null 2>&1 \
                && echo "  GitHub auth [OK]" \
                || echo "  GitHub auth [NOT AUTHENTICATED]"
        fi

        echo
        echo "Cached divergence:"
        show_divergence overleaf
        show_divergence github
        ;;

    *)
        die "Unknown command '$CMD'.
Run 'paper help' or 'paper examples'."
        ;;
esac
