#!/usr/bin/env bash
set -euo pipefail

PROGRAM="paper"

die() { echo "$PROGRAM: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Required command '$1' is not installed."; }
root() { git rev-parse --show-toplevel 2>/dev/null || die "Not inside a Git repository."; }
branch() { git symbolic-ref --quiet --short HEAD 2>/dev/null || die "Detached HEAD; inspect 'git status'."; }
remote_ok() { git remote get-url "$1" >/dev/null 2>&1 || die "Missing remote '$1'."; }

clean() {
    if [[ -n "$(git status --porcelain)" ]]; then
        git status --short
        die "Working tree is not clean. Commit or discard changes first."
    fi
}

no_git_operation() {
    local d
    d="$(git rev-parse --git-dir)"

    if [[ -d "$d/rebase-merge" || -d "$d/rebase-apply" \
        || -f "$d/MERGE_HEAD" || -f "$d/CHERRY_PICK_HEAD" \
        || -f "$d/REVERT_HEAD" ]]; then

        die "A Git operation is already in progress.
Run 'git status'.

To abandon a rebase:
    git rebase --abort"
    fi
}

base_branch() {
    local ref

    ref="$(git symbolic-ref --quiet --short refs/remotes/overleaf/HEAD 2>/dev/null || true)"

    if [[ -n "$ref" ]]; then
        echo "${ref#overleaf/}"
        return
    fi

    git show-ref --verify --quiet refs/remotes/overleaf/main && {
        echo main
        return
    }

    git show-ref --verify --quiet refs/remotes/overleaf/master && {
        echo master
        return
    }

    die "Cannot determine Overleaf's default branch.

Try:
    git fetch overleaf
    git remote set-head overleaf -a"
}

require_base() {
    git show-ref --verify --quiet "refs/heads/$BASE" \
        || die "Overleaf base branch is '$BASE', but no local '$BASE' exists."
}

show_divergence() {
    local r="$1" ahead behind

    if git show-ref --verify --quiet "refs/remotes/$r/$BASE"; then
        read -r ahead behind < <(
            git rev-list --left-right --count "$BASE...$r/$BASE"
        )

        printf "%-20s local ahead: %-3s remote ahead: %-3s\n" \
            "$r/$BASE" "$ahead" "$behind"
    else
        printf "%-20s not fetched / not found\n" "$r/$BASE"
    fi
}

write_gitignore() {
    cat > .gitignore <<'GITIGNORE'
# VS Code local configuration
.vscode/

# LaTeX auxiliary files
*.aux
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.run.xml
*.bcf
*.nav
*.snm
*.vrb

# Generated root-document outputs
main.pdf
main.bbl

# Temporary editor files
*~
*.swp
*.swo

# OS metadata
.DS_Store
GITIGNORE
}

help_text() {
cat <<'HELP'
paper — Overleaf + GitHub workflow for LaTeX papers

MODEL
  overleaf/<base>   collaborative paper
                     (<base> is auto-detected: usually main/master)

  github/<base>     private mirror/backup

  github/<feature>  experimental branches


MENTAL MODEL

  commit
      Local checkpoint.

  backup
      Push current branch to GitHub only.

  publish
      Make committed work visible on Overleaf.


COMMANDS

  paper status
      Show base branch, current branch, status, branches,
      remotes, and cached divergence.

  paper sync
      While on the base branch, pull/rebase the latest
      Overleaf changes.

  paper commit "message"
      git add -A + local commit.
      Pushes nowhere.

  paper backup
      Push current branch to GitHub.
      Never touches Overleaf.

  paper start NAME
      Sync base branch, create NAME, and immediately
      back it up to GitHub.

  paper publish
      From base:
          sync -> GitHub backup -> Overleaf

      From feature:
          sync base
          -> rebase feature
          -> GitHub feature backup
          -> fast-forward base
          -> GitHub base backup
          -> Overleaf

      The feature branch is kept afterward.

  paper abort
      Delete CURRENT non-base branch locally and from GitHub.
      Requires typing its exact name.
      Never touches Overleaf.

  paper clear-experiments
      Delete ALL non-base branches locally and from GitHub.
      Requires typing:

          DELETE EXPERIMENTS

      Never touches Overleaf.

  paper gitignore
      Create the standard paper .gitignore if none exists.
      Existing .gitignore files are never overwritten.

  paper build [ROOT.tex]
      Compile with latexmk.
      Defaults to main.tex.

  paper clean [ROOT.tex]
      Clean latexmk files.
      Defaults to main.tex.

  paper open
      Open the repository in VS Code.

  paper doctor
      Check configuration and useful tools.

  paper examples
      Show concrete example workflows.

  paper help
      Show this help.


CONFLICTS

If sync/publish stops with a conflict:

    git status

Resolve the files, then:

    git add <resolved-files>
    git rebase --continue

Repeat if necessary.

To abandon the rebase:

    git rebase --abort

Then:

    paper status

Do not blindly use:

    git reset --hard
    git clean -fd
HELP
}

examples_text() {
cat <<'EXAMPLES'
EXAMPLE WORKFLOWS


1. SMALL CHANGE

    paper sync
    paper open

    # edit...

    paper commit "Clarify Lemma 7"
    paper publish


2. BACK UP BEFORE PUBLISHING

    paper commit "First proof revision"
    paper backup

    # more work...

    paper publish


3. RISKY EXPERIMENT

    paper start case3-rewrite

    # work...

    paper commit "First construction"
    paper backup

    paper commit "Fix KL argument"
    paper backup


4. EXPERIMENT SUCCEEDED

    paper publish


5. EXPERIMENT FAILED

    paper abort


6. REMOVE ALL LEFTOVER EXPERIMENTS

    paper clear-experiments


7. ADD .gitignore TO AN EXISTING PAPER

    paper gitignore
    paper commit "Add standard paper gitignore"


8. FORGOT WHERE YOU ARE

    paper status
    paper doctor


9. CONFLICT

    git status

    # resolve files...

    git add <resolved-files>
    git rebase --continue


10. ABORT CONFLICT RESOLUTION

    git rebase --abort
    paper status
EXAMPLES
}

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
    help|-h|--help)
        help_text
        exit 0
        ;;

    examples)
        examples_text
        exit 0
        ;;
esac

need git

cd "$(root)"

remote_ok overleaf
remote_ok github

BASE="$(base_branch)"
require_base

case "$CMD" in

    status)
        echo "Repository: $(pwd)"
        echo "Base branch: $BASE"
        echo "Current branch: $(branch)"

        echo
        git status -sb

        echo
        echo "Local branches:"
        git branch -vv

        echo
        echo "Remotes:"
        git remote -v

        echo
        echo "Cached divergence (only as fresh as your last fetch/pull):"
        show_divergence overleaf
        show_divergence github
        ;;

    sync)
        no_git_operation
        clean

        [[ "$(branch)" == "$BASE" ]] \
            || die "Run 'paper sync' from '$BASE', not '$(branch)'."

        git pull --rebase overleaf "$BASE"

        echo "Synchronized '$BASE' with Overleaf."
        echo "GitHub was not modified."
        ;;

    commit)
        no_git_operation

        [[ $# -ge 1 ]] \
            || die 'Usage: paper commit "message"'

        git add -A

        if git diff --cached --quiet; then
            echo "Nothing to commit."
            exit 0
        fi

        git commit -m "$*"
        ;;

    backup)
        no_git_operation
        clean

        B="$(branch)"

        git push --force-with-lease -u github "$B"

        echo "Backed up '$B' to GitHub."
        echo "Overleaf was not modified."
        ;;

    start)
        no_git_operation
        clean

        [[ $# -eq 1 ]] \
            || die "Usage: paper start BRANCH_NAME"

        NEW="$1"

        git check-ref-format --branch "$NEW" >/dev/null 2>&1 \
            || die "Invalid branch name '$NEW'."

        [[ "$NEW" != "$BASE" ]] \
            || die "'$NEW' is the base branch."

        ! git show-ref --verify --quiet "refs/heads/$NEW" \
            || die "Local branch '$NEW' already exists."

        ! git ls-remote --exit-code --heads github "$NEW" >/dev/null 2>&1 \
            || die "GitHub branch '$NEW' already exists."

        git switch "$BASE"
        git pull --rebase overleaf "$BASE"

        git switch -c "$NEW"
        git push -u github "$NEW"

        echo "Started '$NEW'."
        echo "Overleaf was not modified."
        ;;

    publish)
        no_git_operation
        clean

        B="$(branch)"

        if [[ "$B" == "$BASE" ]]; then

            git pull --rebase overleaf "$BASE"
            git push --force-with-lease -u github "$BASE"
            git push overleaf "$BASE"

            echo "Published '$BASE' to GitHub and Overleaf."

        else
            WORK="$B"

            echo "1/6 Update '$BASE' from Overleaf"
            git switch "$BASE"
            git pull --rebase overleaf "$BASE"

            echo "2/6 Rebase '$WORK' onto '$BASE'"
            git switch "$WORK"
            git rebase "$BASE"

            echo "3/6 Back up '$WORK' to GitHub"
            git push --force-with-lease -u github "$WORK"

            echo "4/6 Fast-forward '$BASE'"
            git switch "$BASE"
            git merge --ff-only "$WORK"

            echo "5/6 Back up '$BASE' to GitHub"
            git push --force-with-lease -u github "$BASE"

            echo "6/6 Publish '$BASE' to Overleaf"
            git push overleaf "$BASE"

            echo
            echo "Published successfully."
            echo "Current branch: $BASE"
            echo "Feature '$WORK' was kept."
        fi
        ;;

    abort)
        no_git_operation
        clean

        B="$(branch)"

        [[ "$B" != "$BASE" ]] \
            || die "Cannot abort base branch '$BASE'."

        echo
        echo "This permanently deletes '$B':"
        echo "  - locally"
        echo "  - from GitHub, if present"
        echo
        echo "It does NOT modify '$BASE' or Overleaf."
        echo

        read -r -p "Type '$B' to confirm: " CONFIRM

        [[ "$CONFIRM" == "$B" ]] || {
            echo "Cancelled."
            exit 0
        }

        git switch "$BASE"

        if git ls-remote --exit-code --heads github "$B" >/dev/null 2>&1; then
            git push github --delete "$B"
        fi

        git branch -D "$B"

        echo "Discarded '$B'."
        echo "Overleaf was not modified."
        ;;

    clear-experiments)
        no_git_operation
        clean

        git switch "$BASE"

        mapfile -t LOCAL < <(
            git for-each-ref \
                --format='%(refname:short)' \
                refs/heads/ |
            grep -Fxv "$BASE" || true
        )

        REMOTE_HEADS="$(git ls-remote --heads github)" \
            || die "Could not read GitHub branches."

        mapfile -t REMOTE < <(
            printf '%s\n' "$REMOTE_HEADS" |
            awk '{sub("refs/heads/", "", $2); print $2}' |
            grep -Fxv "$BASE" |
            sed '/^$/d' || true
        )

        mapfile -t ALL < <(
            printf '%s\n' "${LOCAL[@]}" "${REMOTE[@]}" |
            sed '/^$/d' |
            sort -u
        )

        [[ ${#ALL[@]} -gt 0 ]] || {
            echo "No experimental branches found."
            exit 0
        }

        echo
        echo "The following non-base branches will be permanently deleted:"
        printf '  %s\n' "${ALL[@]}"
        echo
        echo "Overleaf and '$BASE' will NOT be modified."
        echo

        read -r -p "Type 'DELETE EXPERIMENTS' to confirm: " CONFIRM

        [[ "$CONFIRM" == "DELETE EXPERIMENTS" ]] || {
            echo "Cancelled."
            exit 0
        }

        for B in "${REMOTE[@]}"; do
            git push github --delete "$B"
        done

        for B in "${LOCAL[@]}"; do
            git branch -D "$B"
        done

        echo "All experimental branches removed."
        ;;

    gitignore)
        no_git_operation

        [[ ! -e .gitignore ]] \
            || die ".gitignore already exists; refusing to overwrite it."

        write_gitignore

        echo "Created .gitignore."
        echo
        echo "Review it, then:"
        echo
        echo '    paper commit "Add standard paper gitignore"'
        ;;

    build)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'. Usage: paper build [ROOT.tex]"

        latexmk \
            -pdf \
            -interaction=nonstopmode \
            -file-line-error \
            "$MAIN"
        ;;

    clean)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'. Usage: paper clean [ROOT.tex]"

        latexmk -C "$MAIN"
        ;;

    open)
        need code
        code .
        ;;

    doctor)
        echo "Repository: $(pwd)"
        echo "Detected base branch: $BASE"

        echo "Overleaf HEAD: $(
            git symbolic-ref \
                --quiet \
                --short \
                refs/remotes/overleaf/HEAD \
                2>/dev/null \
                || echo '<not set>'
        )"

        echo "Current branch: $(branch)"

        echo
        git status -sb

        echo
        echo "Remotes:"
        echo "  overleaf: $(git remote get-url overleaf)"
        echo "  github:   $(git remote get-url github)"

        echo
        UPSTREAM="$(
            git for-each-ref \
                --format='%(upstream:short)' \
                "refs/heads/$BASE"
        )"

        echo "Base upstream:"
        echo "  ${UPSTREAM:-<none>}"
        echo "  expected: github/$BASE"

        echo
        echo "Default push remote:"
        echo "  $(git config --get remote.pushDefault || echo '<none>')"
        echo "  expected: github"

        echo
        echo "Tools:"

        command -v gh >/dev/null 2>&1 \
            && echo "  gh       [OK]" \
            || echo "  gh       [MISSING]"

        command -v latexmk >/dev/null 2>&1 \
            && echo "  latexmk  [OK]" \
            || echo "  latexmk  [MISSING]"

        command -v code >/dev/null 2>&1 \
            && echo "  code     [OK]" \
            || echo "  code     [MISSING]"

        if command -v gh >/dev/null 2>&1; then
            gh auth status >/dev/null 2>&1 \
                && echo "  GitHub auth [OK]" \
                || echo "  GitHub auth [NOT AUTHENTICATED]"
        fi

        echo
        echo "Cached divergence:"
        show_divergence overleaf
        show_divergence github
        ;;

    *)
        die "Unknown command '$CMD'.
Run 'paper help' or 'paper examples'."
        ;;
esac
