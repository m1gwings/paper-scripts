cat > paper <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

PROGRAM="paper"

die() {
    echo "$PROGRAM: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 \
        || die "Required command '$1' is not installed."
}

repo_root() {
    git rev-parse --show-toplevel 2>/dev/null \
        || die "You are not inside a Git repository."
}

current_branch() {
    git symbolic-ref --quiet --short HEAD 2>/dev/null \
        || die "Detached HEAD state. Run 'git status' and fix it before continuing."
}

require_remote() {
    git remote get-url "$1" >/dev/null 2>&1 \
        || die "Required remote '$1' does not exist. Run 'paper doctor'."
}

require_clean() {
    if [[ -n "$(git status --porcelain)" ]]; then
        echo
        git status --short
        echo
        die "Working tree is not clean. Commit or explicitly discard the changes first."
    fi
}

require_master() {
    git show-ref --verify --quiet refs/heads/master \
        || die "This repository has no local 'master' branch."
}

require_no_git_operation() {
    local git_dir
    git_dir="$(git rev-parse --git-dir)"

    if [[ -d "$git_dir/rebase-merge" ]] \
        || [[ -d "$git_dir/rebase-apply" ]] \
        || [[ -f "$git_dir/MERGE_HEAD" ]] \
        || [[ -f "$git_dir/CHERRY_PICK_HEAD" ]] \
        || [[ -f "$git_dir/REVERT_HEAD" ]]; then

        die "A Git rebase/merge/cherry-pick/revert is already in progress.

Run:
    git status

If you are resolving a rebase conflict:
    # edit the conflicted files
    git add <resolved-files>
    git rebase --continue

Or abort the rebase with:
    git rebase --abort"
    fi
}

show_cached_divergence() {
    local remote="$1"

    if git show-ref --verify --quiet "refs/remotes/$remote/master"; then
        local ahead behind
        read -r ahead behind < <(
            git rev-list --left-right --count "master...$remote/master"
        )

        printf "  master vs %-16s local ahead: %-3s remote ahead: %-3s\n" \
            "$remote/master" "$ahead" "$behind"
    fi
}

print_help() {
    cat <<'HELP'
paper — simple workflow for LaTeX papers synchronized with Overleaf + GitHub

REPOSITORY MODEL
================

The expected repository has:

    master
        Collaborative/published paper.

    overleaf
        Overleaf Git remote.
        This is where collaborators edit the paper.

    github
        Private GitHub remote.
        Used as your backup/mirror and for experimental branches.

The intended mental model is:

    COMMIT
        Make a local checkpoint.

    BACKUP
        Copy committed work to GitHub.
        Does NOT modify Overleaf.

    PUBLISH
        Make committed work part of the collaborative Overleaf paper.

The only normal command that pushes changes to Overleaf is:

    paper publish


DAILY COMMANDS
==============

    paper status

        Show the current branch, working tree, branches, remotes, and
        cached master divergence.

        Good first command when you do not remember where you are.


    paper sync

        Update local master from the latest Overleaf master.

        Must be run while you are on master and have a clean working tree.

        Use this before starting normal work:

            paper sync


    paper commit "MESSAGE"

        Stage all non-ignored changes and create a LOCAL Git commit.

        Example:

            paper commit "Fix Case 2 regret calculation"

        This does NOT push anywhere.


    paper backup

        Push the CURRENT BRANCH to GitHub.

        Overleaf is NOT modified.

        Use it when you want your committed work safely stored remotely:

            paper commit "First attempt at new proof"
            paper backup


    paper start BRANCH

        Start an experimental feature branch.

        The command:

          1. switches to master;
          2. updates master from Overleaf;
          3. creates BRANCH;
          4. immediately creates its GitHub backup branch.

        Example:

            paper start case3-rewrite

        Work on the branch, then create checkpoints with:

            paper commit "First Case 3 construction"
            paper backup


    paper publish

        Publish your current committed work.

        If you are on master:

          1. update master from Overleaf;
          2. back up master to GitHub;
          3. push master to Overleaf.

        If you are on a feature branch:

          1. update master from Overleaf;
          2. rebase the feature branch onto current master;
          3. back up the feature branch to GitHub;
          4. fast-forward master to the feature branch;
          5. back up master to GitHub;
          6. push master to Overleaf.

        The feature branch is NOT automatically deleted afterward.

        Example:

            paper publish


EXPERIMENT CLEANUP
==================

    paper abort

        Permanently discard the CURRENT feature branch.

        It deletes that branch:

          - locally;
          - from GitHub, if it exists there.

        It NEVER modifies Overleaf or master.

        You must type the branch name to confirm.

        Example:

            paper abort


    paper clear-experiments

        Permanently delete ALL non-master branches:

          - locally;
          - from GitHub.

        It NEVER modifies:

          - local master;
          - github/master;
          - overleaf/master;
          - the Overleaf project.

        Requires the exact confirmation phrase:

            DELETE EXPERIMENTS


LATEX / EDITOR COMMANDS
=======================

    paper build [ROOT.tex]

        Compile with latexmk.

        Defaults to:

            main.tex

        Example:

            paper build
            paper build aistats.tex


    paper clean [ROOT.tex]

        Remove latexmk-generated files.

        Defaults to main.tex.


    paper open

        Open the repository in VS Code.


DIAGNOSTICS
===========

    paper doctor

        Check the repository configuration and available tools.

        Useful when setting up a new paper or machine.


    paper examples

        Show example workflows for:

          - small changes on master;
          - experimental branches;
          - backing up without publishing;
          - abandoning an experiment;
          - cleaning all experiments;
          - recovering from Git conflicts.


    paper help

        Show this help.


CONFLICTS
=========

If 'paper sync' or 'paper publish' stops because of a Git conflict:

    git status

Git will tell you which files conflict.

Resolve the files, then:

    git add <resolved-files>
    git rebase --continue

Repeat until the rebase finishes.

If you decide you do NOT want to continue the rebase:

    git rebase --abort

After recovery, inspect the repository:

    paper status

and rerun the original paper command when appropriate.

IMPORTANT:
    Never blindly use 'git reset --hard' or 'git clean -fd' to solve a
    conflict unless you understand exactly what will be deleted.


SAFETY INVARIANTS
=================

- 'paper abort' never touches Overleaf.
- 'paper clear-experiments' never touches Overleaf.
- 'paper backup' never touches Overleaf.
- 'paper publish' requires a clean working tree.
- destructive operations require explicit confirmation.
- GitHub is treated as your personal mirror/backup.
- Overleaf master is treated as the collaborative paper.

Run:

    paper examples

for concrete workflows.
HELP
}

print_examples() {
    cat <<'EXAMPLES'
PAPER WORKFLOW EXAMPLES
=======================


1. SMALL CHANGE DIRECTLY ON MASTER
----------------------------------

Start from your collaborators' latest version:

    paper sync

Edit the paper.

Create a checkpoint:

    paper commit "Clarify warm-up lemma"

Continue editing if desired:

    paper commit "Fix constants in Case 2"

Publish everything:

    paper publish


2. SMALL CHANGE, BUT BACK IT UP BEFORE PUBLISHING
-------------------------------------------------

    paper sync

    # edit...

    paper commit "Rewrite introduction paragraph"

Back it up to GitHub without changing Overleaf:

    paper backup

Continue working.

When ready for collaborators to see it:

    paper publish


3. START A RISKY EXPERIMENT
---------------------------

For example, you want to let Codex substantially rewrite a proof:

    paper start case3-rewrite

Now you are on:

    case3-rewrite

Create checkpoints freely:

    paper commit "First alternative construction"
    paper commit "Repair KL argument"

Back up the branch:

    paper backup

Overleaf is still untouched.


4. PUBLISH A SUCCESSFUL EXPERIMENT
----------------------------------

While on the feature branch:

    paper publish

The command integrates the branch into current master and publishes master
to both GitHub and Overleaf.

The feature branch remains available afterward.

If you later want to remove leftover experimental branches:

    paper clear-experiments


5. ABANDON THE CURRENT EXPERIMENT
---------------------------------

Suppose you are on:

    bad-proof-idea

and everything is committed or otherwise clean.

Run:

    paper abort

You will see something like:

    Type 'bad-proof-idea' to confirm:

After confirmation, the branch is removed locally and from GitHub.

Overleaf is untouched.


6. DELETE ALL LEFTOVER EXPERIMENTAL BRANCHES
--------------------------------------------

    paper clear-experiments

The command first lists every non-master branch that would disappear.

Nothing happens unless you type:

    DELETE EXPERIMENTS

Overleaf and master are preserved.


7. CHECK WHERE YOU ARE
----------------------

If you return to a project after two weeks and remember nothing:

    paper status

If something looks wrong:

    paper doctor

If you do not remember the commands:

    paper help


8. CONFLICT DURING SYNC OR PUBLISH
----------------------------------

Suppose Git reports a conflict.

First:

    git status

Open the conflicting .tex files and resolve the conflict markers.

Then:

    git add appendix.tex

Continue:

    git rebase --continue

If another conflict appears, repeat.

If you want to abandon the entire rebase:

    git rebase --abort

Then inspect:

    paper status


9. TYPICAL DAY
--------------

    cd ~/research/my-project/paper
    paper sync
    paper open

    # work...

    paper commit "Improve lower-bound proof"

    # more work...

    paper commit "Clean notation"

    paper backup

    # when satisfied:

    paper publish


10. TYPICAL LARGE CHANGE
------------------------

    cd ~/research/my-project/paper

    paper start new-lower-bound

    # work with VS Code / Codex

    paper commit "Set up alternative instance family"
    paper backup

    # more work

    paper commit "Complete Pinsker argument"
    paper backup

    # successful:
    paper publish

or, if the idea failed:

    paper abort
EXAMPLES
}

COMMAND="${1:-help}"

if [[ $# -gt 0 ]]; then
    shift
fi

case "$COMMAND" in
    help|-h|--help)
        print_help
        exit 0
        ;;

    examples)
        print_examples
        exit 0
        ;;
esac

need git

cd "$(repo_root)"

require_remote overleaf
require_remote github
require_master

case "$COMMAND" in

    status)
        echo "=== Repository ==="
        pwd

        echo
        echo "=== Current branch ==="
        current_branch

        echo
        echo "=== Working tree ==="
        git status -sb

        echo
        echo "=== Local branches ==="
        git branch -vv

        echo
        echo "=== Remotes ==="
        git remote -v

        echo
        echo "=== Cached master divergence ==="
        echo "(Remote information is only as fresh as your last fetch/pull.)"
        show_cached_divergence overleaf
        show_cached_divergence github
        ;;

    sync)
        require_no_git_operation
        require_clean

        BRANCH="$(current_branch)"

        if [[ "$BRANCH" != "master" ]]; then
            die "'paper sync' must be run from master.

Current branch:
    $BRANCH

If this is an experiment, normally keep working there and use
'paper publish' when it is ready."
        fi

        echo "Updating master from Overleaf..."
        git pull --rebase overleaf master

        echo
        echo "Local master is now synchronized with Overleaf."
        echo "GitHub has not been modified."
        echo "Run 'paper backup' if you also want to refresh the GitHub mirror."
        ;;

    commit)
        require_no_git_operation

        if [[ $# -lt 1 ]]; then
            die 'Usage: paper commit "commit message"'
        fi

        git add -A

        if git diff --cached --quiet; then
            echo "Nothing to commit."
            exit 0
        fi

        git commit -m "$*"
        ;;

    backup)
        require_no_git_operation
        require_clean

        BRANCH="$(current_branch)"

        echo "Backing up '$BRANCH' to GitHub..."

        # GitHub is intentionally treated as a personal mirror/backup.
        # --force-with-lease allows rebased local history to replace the
        # previous mirror while refusing to overwrite unexpected remote work.
        git push --force-with-lease -u github "$BRANCH"

        echo
        echo "Backup complete."
        echo "Overleaf was not modified."
        ;;

    start)
        require_no_git_operation
        require_clean

        if [[ $# -ne 1 ]]; then
            die "Usage: paper start BRANCH_NAME"
        fi

        NEW_BRANCH="$1"

        git check-ref-format --branch "$NEW_BRANCH" >/dev/null 2>&1 \
            || die "'$NEW_BRANCH' is not a valid Git branch name."

        if git show-ref --verify --quiet "refs/heads/$NEW_BRANCH"; then
            die "Local branch '$NEW_BRANCH' already exists."
        fi

        if git ls-remote --exit-code --heads github "$NEW_BRANCH" >/dev/null 2>&1; then
            die "GitHub branch '$NEW_BRANCH' already exists."
        fi

        echo "Switching to master..."
        git switch master

        echo
        echo "Updating master from Overleaf..."
        git pull --rebase overleaf master

        echo
        echo "Creating experimental branch '$NEW_BRANCH'..."
        git switch -c "$NEW_BRANCH"

        echo
        echo "Creating GitHub backup branch..."
        git push -u github "$NEW_BRANCH"

        echo
        echo "Experiment '$NEW_BRANCH' is ready."
        echo "Overleaf was not modified."
        ;;

    publish)
        require_no_git_operation
        require_clean

        BRANCH="$(current_branch)"

        if [[ "$BRANCH" == "master" ]]; then
            echo "Updating master from Overleaf..."
            git pull --rebase overleaf master

            echo
            echo "Backing up master to GitHub..."
            git push --force-with-lease -u github master

            echo
            echo "Publishing master to Overleaf..."
            git push overleaf master

            echo
            echo "Published successfully."

        else
            WORK_BRANCH="$BRANCH"

            echo "Publishing experimental branch '$WORK_BRANCH'."

            echo
            echo "Step 1/6: updating master from Overleaf..."
            git switch master
            git pull --rebase overleaf master

            echo
            echo "Step 2/6: rebasing '$WORK_BRANCH' onto current master..."
            git switch "$WORK_BRANCH"
            git rebase master

            echo
            echo "Step 3/6: backing up rebased feature branch to GitHub..."
            git push --force-with-lease -u github "$WORK_BRANCH"

            echo
            echo "Step 4/6: fast-forwarding master..."
            git switch master
            git merge --ff-only "$WORK_BRANCH"

            echo
            echo "Step 5/6: backing up master to GitHub..."
            git push --force-with-lease -u github master

            echo
            echo "Step 6/6: publishing master to Overleaf..."
            git push overleaf master

            echo
            echo "Published successfully."
            echo
            echo "Current branch: master"
            echo "Experimental branch '$WORK_BRANCH' was kept."
            echo "Delete it later with 'paper clear-experiments' if desired."
        fi
        ;;

    abort)
        require_no_git_operation
        require_clean

        BRANCH="$(current_branch)"

        if [[ "$BRANCH" == "master" ]]; then
            die "Cannot abort master."
        fi

        echo
        echo "DANGER: you are about to permanently discard:"
        echo
        echo "    $BRANCH"
        echo
        echo "The branch will be deleted:"
        echo "    - locally"
        echo "    - from GitHub, if present"
        echo
        echo "The following will NOT be modified:"
        echo "    - local master"
        echo "    - github/master"
        echo "    - overleaf/master"
        echo "    - the Overleaf project"
        echo
        echo "Unmerged commits on '$BRANCH' will be lost."
        echo

        read -r -p "Type '$BRANCH' to confirm: " CONFIRM

        if [[ "$CONFIRM" != "$BRANCH" ]]; then
            echo "Abort cancelled. Nothing was changed."
            exit 0
        fi

        echo
        echo "Switching to master..."
        git switch master

        if git ls-remote --exit-code --heads github "$BRANCH" >/dev/null 2>&1; then
            echo
            echo "Deleting GitHub branch '$BRANCH'..."
            git push github --delete "$BRANCH"
        fi

        echo
        echo "Deleting local branch '$BRANCH'..."
        git branch -D "$BRANCH"

        echo
        echo "Experiment '$BRANCH' discarded."
        echo "Overleaf was not modified."
        ;;

    clear-experiments)
        require_no_git_operation
        require_clean

        echo "Switching to master..."
        git switch master

        mapfile -t LOCAL_BRANCHES < <(
            git for-each-ref \
                --format='%(refname:short)' \
                refs/heads/ |
            grep -v '^master$' || true
        )

        REMOTE_HEADS="$(git ls-remote --heads github)" \
            || die "Could not read GitHub branches."

        mapfile -t GITHUB_BRANCHES < <(
            printf '%s\n' "$REMOTE_HEADS" |
            awk '{sub("refs/heads/", "", $2); print $2}' |
            grep -v '^master$' |
            sed '/^$/d' || true
        )

        mapfile -t ALL_BRANCHES < <(
            printf '%s\n' \
                "${LOCAL_BRANCHES[@]}" \
                "${GITHUB_BRANCHES[@]}" |
            sed '/^$/d' |
            sort -u
        )

        if [[ "${#ALL_BRANCHES[@]}" -eq 0 ]]; then
            echo
            echo "No experimental branches found."
            exit 0
        fi

        echo
        echo "DANGER: the following experimental branches will be"
        echo "permanently deleted:"
        echo

        for BRANCH in "${ALL_BRANCHES[@]}"; do
            echo "    $BRANCH"
        done

        echo
        echo "They will be deleted:"
        echo "    - locally, when present"
        echo "    - from GitHub, when present"
        echo
        echo "The following will NOT be modified:"
        echo "    - local master"
        echo "    - github/master"
        echo "    - overleaf/master"
        echo "    - the Overleaf project"
        echo

        read -r -p "Type 'DELETE EXPERIMENTS' to confirm: " CONFIRM

        if [[ "$CONFIRM" != "DELETE EXPERIMENTS" ]]; then
            echo "Cleanup cancelled. Nothing was changed."
            exit 0
        fi

        # Delete GitHub copies first. If a remote deletion fails,
        # local branches remain available.
        for BRANCH in "${GITHUB_BRANCHES[@]}"; do
            echo
            echo "Deleting GitHub branch '$BRANCH'..."
            git push github --delete "$BRANCH"
        done

        for BRANCH in "${LOCAL_BRANCHES[@]}"; do
            echo
            echo "Deleting local branch '$BRANCH'..."
            git branch -D "$BRANCH"
        done

        echo
        echo "All experimental branches have been removed."
        echo "Overleaf and master were not modified."
        ;;

    build)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'.

Usage:
    paper build [ROOT.tex]"

        latexmk \
            -pdf \
            -interaction=nonstopmode \
            -file-line-error \
            "$MAIN"
        ;;

    clean)
        need latexmk

        MAIN="${1:-main.tex}"

        [[ -f "$MAIN" ]] \
            || die "Cannot find '$MAIN'.

Usage:
    paper clean [ROOT.tex]"

        latexmk -C "$MAIN"
        ;;

    open)
        need code
        code .
        ;;

    doctor)
        echo "=== Repository ==="
        pwd

        echo
        echo "=== Current branch ==="
        current_branch

        echo
        echo "=== Working tree ==="
        git status -sb

        echo
        echo "=== Expected remotes ==="
        echo "overleaf:"
        git remote get-url overleaf
        echo
        echo "github:"
        git remote get-url github

        echo
        echo "=== master upstream ==="
        UPSTREAM="$(
            git for-each-ref \
                --format='%(upstream:short)' \
                refs/heads/master
        )"

        if [[ "$UPSTREAM" == "github/master" ]]; then
            echo "github/master  [OK]"
        else
            echo "${UPSTREAM:-<none>}  [expected github/master]"
        fi

        echo
        echo "=== default push remote ==="
        PUSH_DEFAULT="$(git config --get remote.pushDefault || true)"

        if [[ "$PUSH_DEFAULT" == "github" ]]; then
            echo "github  [OK]"
        else
            echo "${PUSH_DEFAULT:-<none>}  [expected github]"
        fi

        echo
        echo "=== Tools ==="

        printf "git:      "
        git --version

        printf "gh:       "
        if command -v gh >/dev/null 2>&1; then
            gh --version | head -n 1
        else
            echo "NOT FOUND"
        fi

        printf "latexmk:  "
        if command -v latexmk >/dev/null 2>&1; then
            latexmk -v 2>/dev/null | head -n 1 || echo "found"
        else
            echo "NOT FOUND"
        fi

        printf "VS Code:  "
        if command -v code >/dev/null 2>&1; then
            echo "found"
        else
            echo "NOT FOUND"
        fi

        echo
        echo "=== GitHub authentication ==="
        if command -v gh >/dev/null 2>&1; then
            if gh auth status >/dev/null 2>&1; then
                echo "authenticated"
            else
                echo "NOT authenticated"
                echo "Run: gh auth login"
            fi
        else
            echo "GitHub CLI not installed."
        fi

        echo
        echo "=== Cached divergence ==="
        show_cached_divergence overleaf
        show_cached_divergence github

        echo
        echo "Doctor check complete."
        ;;

    *)
        die "Unknown command '$COMMAND'.

Run:
    paper help

or:
    paper examples"
        ;;
esac
EOF
